{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommetoResearchInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "discover",
        "audit",
        "learning_sequence"
      ],
      "default": "discover"
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Preferred source platforms; availability is not guaranteed."
    },
    "depth_level": {
      "enum": [
        "introductory",
        "intermediate",
        "advanced",
        "deep_dive"
      ],
      "default": "intermediate"
    },
    "target_audience": {
      "type": "string",
      "default": "general"
    },
    "video_language": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "response_language": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "min_credibility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.75,
      "description": "Editorial rubric threshold, not a probability of truth."
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    },
    "require_transcripts": {
      "type": "boolean",
      "default": true
    },
    "exclude_shorts": {
      "type": "boolean",
      "default": true
    },
    "max_duration_minutes": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "default": null
    },
    "output_format": {
      "enum": [
        "markdown",
        "json",
        "both"
      ],
      "default": "markdown"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "audit"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "video_urls"
        ],
        "properties": {
          "video_urls": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
